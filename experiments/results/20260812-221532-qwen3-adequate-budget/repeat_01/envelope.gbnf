char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
date ::= [0-9]{4} "-" ( "0" [1-9] | "1" [0-2] ) "-" ( "0" [1-9] | [1-2] [0-9] | "3" [0-1] )
date-string ::= "\"" date "\""
null ::= "null"
ref-defs-BloodTypeEnum ::= ("\"A+\"" | "\"A-\"" | "\"B+\"" | "\"B-\"" | "\"AB+\"" | "\"AB-\"" | "\"O+\"" | "\"O-\"")
ref-defs-ConstantDataSetup ::= "{" space  (ref-defs-ConstantDataSetup-name-kv ref-defs-ConstantDataSetup-name-rest | ref-defs-ConstantDataSetup-gender-kv ref-defs-ConstantDataSetup-gender-rest | ref-defs-ConstantDataSetup-height-kv ref-defs-ConstantDataSetup-height-rest | ref-defs-ConstantDataSetup-blood-type-kv ref-defs-ConstantDataSetup-blood-type-rest | ref-defs-ConstantDataSetup-date-of-birth-kv )? space "}"
ref-defs-ConstantDataSetup-blood-type ::= ref-defs-ConstantDataSetup-blood-type-0 | null
ref-defs-ConstantDataSetup-blood-type-0 ::= ref-defs-BloodTypeEnum
ref-defs-ConstantDataSetup-blood-type-kv ::= "\"blood_type\"" space ":" space ref-defs-ConstantDataSetup-blood-type
ref-defs-ConstantDataSetup-blood-type-rest ::= ( "," space ref-defs-ConstantDataSetup-date-of-birth-kv )?
ref-defs-ConstantDataSetup-date-of-birth ::= ref-defs-ConstantDataSetup-date-of-birth-0 | null
ref-defs-ConstantDataSetup-date-of-birth-0 ::= date-string
ref-defs-ConstantDataSetup-date-of-birth-kv ::= "\"date_of_birth\"" space ":" space ref-defs-ConstantDataSetup-date-of-birth
ref-defs-ConstantDataSetup-gender ::= ref-defs-ConstantDataSetup-gender-0 | null
ref-defs-ConstantDataSetup-gender-0 ::= ("\"male\"" | "\"female\"" | "\"other\"")
ref-defs-ConstantDataSetup-gender-kv ::= "\"gender\"" space ":" space ref-defs-ConstantDataSetup-gender
ref-defs-ConstantDataSetup-gender-rest ::= ( "," space ref-defs-ConstantDataSetup-height-kv )? ref-defs-ConstantDataSetup-height-rest
ref-defs-ConstantDataSetup-height ::= ref-defs-ConstantDataSetup-height-0 | null
ref-defs-ConstantDataSetup-height-0 ::= ([0-9] | ([1-8] [0-9] | [9] [0-9]) | ([1] [0-9]{2} | [2] ([0-4] [0-9] | [5] "0")))
ref-defs-ConstantDataSetup-height-kv ::= "\"height\"" space ":" space ref-defs-ConstantDataSetup-height
ref-defs-ConstantDataSetup-height-rest ::= ( "," space ref-defs-ConstantDataSetup-blood-type-kv )? ref-defs-ConstantDataSetup-blood-type-rest
ref-defs-ConstantDataSetup-name ::= ref-defs-ConstantDataSetup-name-0 | null
ref-defs-ConstantDataSetup-name-0 ::= "\"" char{0,100} "\""
ref-defs-ConstantDataSetup-name-kv ::= "\"name\"" space ":" space ref-defs-ConstantDataSetup-name
ref-defs-ConstantDataSetup-name-rest ::= ( "," space ref-defs-ConstantDataSetup-gender-kv )? ref-defs-ConstantDataSetup-gender-rest
ref-defs-MedScreeningInputStatus ::= ("\"incomplete\"" | "\"complete\"" | "\"skipped\"")
ref-defs-MissingInfo ::= "{" space ref-defs-MissingInfo-field-kv "," space ref-defs-MissingInfo-question-kv space "}"
ref-defs-MissingInfo-field ::= "\"" char{0,50} "\""
ref-defs-MissingInfo-field-kv ::= "\"field\"" space ":" space ref-defs-MissingInfo-field
ref-defs-MissingInfo-question ::= "\"" char{0,200} "\""
ref-defs-MissingInfo-question-kv ::= "\"question\"" space ":" space ref-defs-MissingInfo-question
ref-defs-ThoughtStep ::= "{" space ref-defs-ThoughtStep-thought-kv "," space ref-defs-ThoughtStep-action-kv "," space ref-defs-ThoughtStep-action-input-kv space "}"
ref-defs-ThoughtStep-action ::= "\"" char{0,100} "\""
ref-defs-ThoughtStep-action-input ::= "\"" char{0,200} "\""
ref-defs-ThoughtStep-action-input-kv ::= "\"action_input\"" space ":" space ref-defs-ThoughtStep-action-input
ref-defs-ThoughtStep-action-kv ::= "\"action\"" space ":" space ref-defs-ThoughtStep-action
ref-defs-ThoughtStep-thought ::= "\"" char{0,500} "\""
ref-defs-ThoughtStep-thought-kv ::= "\"thought\"" space ":" space ref-defs-ThoughtStep-thought
root ::= "{" space tool-calls-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
tool-calls ::= "[" space tool-calls-item  space "]"
tool-calls-item ::= "{" space tool-calls-item-name-kv "," space tool-calls-item-arguments-kv "," space tool-calls-item-id-kv space "}"
tool-calls-item-arguments ::= "{" space tool-calls-item-arguments-thoughts-kv "," space tool-calls-item-arguments-status-kv "," space tool-calls-item-arguments-current-info-kv ( "," space ( tool-calls-item-arguments-missing-info-kv ) )? space "}"
tool-calls-item-arguments-current-info ::= ref-defs-ConstantDataSetup
tool-calls-item-arguments-current-info-kv ::= "\"current_info\"" space ":" space tool-calls-item-arguments-current-info
tool-calls-item-arguments-kv ::= "\"arguments\"" space ":" space tool-calls-item-arguments
tool-calls-item-arguments-missing-info ::= tool-calls-item-arguments-missing-info-0 | null
tool-calls-item-arguments-missing-info-0 ::= ref-defs-MissingInfo
tool-calls-item-arguments-missing-info-kv ::= "\"missing_info\"" space ":" space tool-calls-item-arguments-missing-info
tool-calls-item-arguments-status ::= ref-defs-MedScreeningInputStatus
tool-calls-item-arguments-status-kv ::= "\"status\"" space ":" space tool-calls-item-arguments-status
tool-calls-item-arguments-thoughts ::= "[" space (tool-calls-item-arguments-thoughts-item ("," space tool-calls-item-arguments-thoughts-item)*)? space "]"
tool-calls-item-arguments-thoughts-item ::= ref-defs-ThoughtStep
tool-calls-item-arguments-thoughts-kv ::= "\"thoughts\"" space ":" space tool-calls-item-arguments-thoughts
tool-calls-item-id-kv ::= "\"id\"" space ":" space string
tool-calls-item-name ::= "\"send_medical_data_en\""
tool-calls-item-name-kv ::= "\"name\"" space ":" space tool-calls-item-name
tool-calls-kv ::= "\"tool_calls\"" space ":" space tool-calls
